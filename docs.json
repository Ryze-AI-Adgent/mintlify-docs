{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Help Center",
  "colors": {
    "primary": "#242424",
    "light": "#F5F5F5",
    "dark": "#1A1A1A"
  },
  "fonts": {
    "family": "Plus Jakarta Sans"
  },
  "favicon": "/favicon.ico",
  "seo": {
    "metatags": {
      "description": "Help center for Ryze AI — the AI ad manager for Meta, Google, TikTok, and more.",
      "og:type": "website",
      "og:site_name": "Ryze AI",
      "og:title": "Ryze AI Help Center",
      "og:description": "Connect your ad accounts, set up Ryze in Claude, and manage billing — all in one place.",
      "og:image": "/images/og.png",
      "twitter:card": "summary_large_image",
      "twitter:title": "Ryze AI Help Center",
      "twitter:description": "Connect your ad accounts, set up Ryze in Claude, and manage billing — all in one place.",
      "twitter:image": "/images/og.png"
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "search": {
    "prompt": "Search Ryze docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "General",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "claude/connect",
              "chatgpt/connect",
              "claude/permissions",
              "claude/faq"
            ]
          },
          {
            "group": "Connect Your Platforms",
            "pages": [
              "integrations/overview",
              "integrations/multiple-accounts",
              "integrations/shopify",
              "integrations/wordpress",
              "integrations/framer",
              "integrations/wix",
              "integrations/github",
              "integrations/openai",
              "integrations/klaviyo",
              "integrations/faq"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "billing/invoices-and-payment",
              "billing/manage-subscription",
              "billing/faq"
            ]
          },
          {
            "group": "Workspaces & Team",
            "pages": [
              "workspaces/create-workspace",
              "workspaces/settings",
              "workspaces/invite-teammates",
              "workspaces/faq"
            ]
          },
          {
            "group": "Security & Compliance",
            "pages": [
              "security/overview",
              "security/data-storage",
              "security/data-processing"
            ]
          }
        ]
      },
      {
        "tab": "Paid Ads",
        "groups": [
          {
            "group": "Paid Ads",
            "pages": [
              "paid-ads/introduction",
              "paid-ads/ai-creatives",
              "paid-ads/competitors",
              "paid-ads/reports",
              "paid-ads/schedules",
              "paid-ads/credits",
              "paid-ads/faq"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.get-ryze.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://reports.get-ryze.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]

              "integrations/openai",
              "integrations/ahrefs",
              "integrations/semrush",
              "integrations/anthropic",
              "integrations/klaviyo",
              "integrations/hubspot",
              "integrations/faq"
            ]
          },
          {
            "group": "Agent",
            "pages": [
              "agent/context",
              "agent/approvals",
              "agent/reports",
              "agent/schedules",
              "agent/credits"
            ]
          },
          {

              "white-label/access"
            ]
          },
          {
            "group": "Security & Compliance",
            "pages": [
              "security/overview",
              "security/data-storage",
              "security/data-processing"
            ]
          }
        ]
      },
      {
        "tab": "SEO",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "seo/introduction",
              "seo/how-it-works"
            ]
          },
          {
            "group": "Foundations",
            "pages": [
              "seo/keywords"
            ]
          },
          {
            "group": "On-Page",
            "pages": [
              "seo/programmatic",

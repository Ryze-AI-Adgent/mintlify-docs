    {
      "source": "/paid-ads/reports",
      "destination": "/agent/reports"
    },
    {
      "source": "/paid-ads/schedules",
      "destination": "/agent/schedules"
    },
    {
      "source": "/paid-ads/credits",
      "destination": "/agent/credits"

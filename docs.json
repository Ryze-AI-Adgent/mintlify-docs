  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/get-ryze-ai/"
    },
    "links": [
      {
        "header": "Legal",
        "items": [
          {
            "label": "Privacy Policy",
            "href": "https://www.get-ryze.ai/privacy"
          },
          {
            "label": "Terms of Service",
            "href": "https://www.get-ryze.ai/term-services"
          }
        ]
      }
    ]
  }
